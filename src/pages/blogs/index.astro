---
import Base from '../../layouts/Base.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import BlogList from '../../components/BlogList.astro';
import { getPosts } from '../../lib/posts';
import { breadcrumbs, SITE } from '../../lib/seo';

const posts = await getPosts();
---

<Base
  title="Writing — Mohammad Shahnawaz"
  description="Technical blog posts on building asynchronous systems, Model Context Protocol (MCP) servers, vector databases, and agentic AI architectures."
  jsonLd={[
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Writing', path: '/blogs/' }]),
    { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Writing', url: `${SITE}/blogs/`, isPartOf: { '@id': `${SITE}/#website` } },
  ]}
>
  <main class="column page">
    <div class="page-bar">
      <a class="back" href="/">← Home</a>
      <ThemeToggle />
    </div>
    <h1>Writing</h1>
    <p class="lead">Field notes on systems, AI agents, and the craft of building software.</p>
    <BlogList posts={posts} />
    <footer><small>&copy; 2026 Mohammad Shahnawaz</small></footer>
  </main>
</Base>
