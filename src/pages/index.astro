---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import BlogList from '../components/BlogList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GithubActivity from '../components/GithubActivity.astro';
import OpenSource from '../components/OpenSource.astro';
import { getPosts, getProjects } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
const projects = await getProjects();
---

<Base
  title="Mohammad Shahnawaz — Software Engineer"
  description="Backend software engineer building memory, infrastructure, and tools for AI agents, FastAPI services, and production web apps."
>
  <nav class="index" id="index" aria-label="Page index">
      <p class="index-label">Index</p>
      <a href="#home">Home</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#open-source">Open Source</a>
      <a href="#skills">Skills</a>
      <a href="#highlights">Highlights</a>
      <a href="#activity">Activity</a>
      <a href="#writing">Writing</a>
  </nav>

  <main class="column">
      <Banner />

      <header class="hero" id="home">
          <ThemeToggle />
          <div class="profile">
              <div class="avatar-frame">
                  <img src="/profile.png" alt="Mohammad Shahnawaz" class="avatar">
              </div>
              <div class="identity">
                  <h1>Mohammad Shahnawaz</h1>
                  <p class="handle">@Mshahnawaz1</p>
                  <p class="location">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                      India
                  </p>
              </div>
          </div>

          <div class="bio">
              <p>Backend engineer. I love building, breaking, and shipping asynchronous architectures &amp; agentic AI tools.</p>
              <p>Async FastAPI services, PostgreSQL vector schemas, and MCP toolkits. Seeking junior backend or AI engineering roles.</p>
          </div>

          <div class="socials">
              <a class="icon-btn" href="https://github.com/Mshahnawaz1" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
              </a>
              <a class="icon-btn" href="https://linkedin.com/in/Mshahnawaz1" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
              </a>
              <a class="icon-btn" href="mailto:mshahnawaz1.dev@gmail.com" aria-label="Email" title="mshahnawaz1.dev@gmail.com">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v.4l-10 6.25L2 5.9v-.4Zm0 2.76V18.5A1.5 1.5 0 0 0 3.5 20h17a1.5 1.5 0 0 0 1.5-1.5V8.26l-9.47 5.92a1 1 0 0 1-1.06 0L2 8.26Z"/></svg>
              </a>
              <a class="icon-btn" href="/MShahnawaz.pdf" target="_blank" rel="noopener noreferrer" aria-label="Resume" title="Resume">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 2H6.5A2.5 2.5 0 0 0 4 4.5v15A2.5 2.5 0 0 0 6.5 22h11a2.5 2.5 0 0 0 2.5-2.5V8l-6-6Zm-1 7V3.5L18.5 9H13Zm-1 3a1 1 0 0 1 1 1v3.59l1.3-1.3a1 1 0 1 1 1.4 1.42l-3 3a1 1 0 0 1-1.4 0l-3-3a1 1 0 1 1 1.4-1.42l1.3 1.3V13a1 1 0 0 1 1-1Z"/></svg>
              </a>
          </div>
      </header>

      <section id="experience">
          <h2 class="heading">Experience</h2>
          <article class="entry">
              <div class="logo logo-img"><img src="/dots_in.png" alt="dots.in logo" /></div>
              <div class="entry-body">
                  <h3>dots.in</h3>
                  <p class="role">Backend AI Intern · Bengaluru</p>
                  <details open>
                      <summary>Nov 2026 – Present <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
                      <ul>
                          <li>Building <strong>Dots-Harness</strong>, a web-based agent with memory management and <strong>10+ tools and skills</strong> for working with PDFs, markdown, in-chat responses (using A2UI) and an agent-interactable canvas.</li>
                          <li>Reduced LLM input-token cost by <strong>94%</strong> per request (11K to 0.6K tokens) by replacing always-on prompts and tool schemas with lazily loaded skills and search-based tool discovery.</li>
                          <li>Implemented per-file <strong>version control</strong> (last 50 revisions, restore, agent/user attribution) for generated documents, so users can let the agent edit their files and roll back any change.</li>
                      </ul>
                      <div class="tags"><span class="tag">Python</span><span class="tag">AI Agents</span><span class="tag">A2UI</span><span class="tag">LLMs</span></div>
                  </details>
              </div>
          </article>
          <article class="entry">
              <div class="logo logo-img logo-dark"><img src="/flyrank_ai.png" alt="FlyRank.ai logo" /></div>
              <div class="entry-body">
                  <h3>Flyrank.ai</h3>
                  <p class="role">AI Engineering Intern</p>
                  <details>
                      <summary>Jul 2026 – Oct 2026 <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
                      <ul>
                          <li>Built an AI-assisted chatbot grounded in <strong>50+ FAQ documents</strong> using a RAG-based system.</li>
                          <li>Designed a schema-first RAG pipeline routing typed field queries to direct lookups and unstructured queries to ChromaDB (lfm-2.5-embedding), eliminating semantic-search overhead for exact-match questions.</li>
                          <li>Improved <strong>recall@5 from 40% to 75%</strong> using hybrid retrieval (semantic + BM25) with a cross-encoder reranker, evaluated on a 70-query golden dataset.</li>
                      </ul>
                      <div class="tags"><span class="tag">RAG</span><span class="tag">ChromaDB</span><span class="tag">BM25</span><span class="tag">Reranking</span></div>
                  </details>
              </div>
          </article>
          <article class="entry">
              <div class="logo logo-img"><img src="/raza_studioz.png" alt="Raza Studioz logo" /></div>
              <div class="entry-body">
                  <h3>Raza Studioz</h3>
                  <p class="role">Software Developer (Contract)</p>
                  <details>
                      <summary>Dec 2025 – Feb 2026 <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
                      <ul>
                          <li>Built a full-stack web app with React, serverless REST API, and Supabase (PostgreSQL) serving <strong>100+ active users</strong>.</li>
                          <li>Engineered an email dispatch system with Resend for real-time admin notifications (sub-2s delivery), while collaborating with the founder to clarify evolving requirements and prioritize features under shifting deadlines.</li>
                      </ul>
                      <div class="tags"><span class="tag">React</span><span class="tag">Supabase</span><span class="tag">PostgreSQL</span><span class="tag">Resend</span></div>
                  </details>
              </div>
          </article>
      </section>

      <section id="projects">
          <h2 class="heading">Projects</h2>
          <div class="cards">
              {projects.map((project) => <ProjectCard project={project} />)}
          </div>
      </section>

      <section id="open-source">
          <h2 class="heading">Open Source Contributions</h2>
          <OpenSource />
      </section>

      <section id="skills">
          <h2 class="heading">Skills</h2>
          <div class="skills">
              <span class="skill">Python</span><span class="skill">JavaScript</span><span class="skill">SQL</span>
              <span class="skill">LangChain</span><span class="skill">LangGraph</span><span class="skill">MCP</span><span class="skill">LLMs</span><span class="skill">RAG</span><span class="skill">Embeddings</span><span class="skill">ChromaDB</span>
              <span class="skill">FastAPI</span><span class="skill">Flask</span><span class="skill">Pydantic</span><span class="skill">REST APIs</span><span class="skill">Async Programming</span><span class="skill">React</span><span class="skill">Supabase</span>
              <span class="skill">PostgreSQL</span><span class="skill">Redis</span><span class="skill">Docker</span><span class="skill">CI/CD</span><span class="skill">Linux</span><span class="skill">Railway</span><span class="skill">Vercel</span><span class="skill">Hugging Face</span>
              <span class="skill">Git</span><span class="skill">GitHub</span><span class="skill">Pytest</span><span class="skill">VS Code</span><span class="skill">Cursor</span>
          </div>
      </section>

      <section id="highlights">
          <h2 class="heading">Highlights</h2>
          <div class="marquee">
              <div class="marquee-track" id="marquee-track">
                  <div class="highlight"><strong>Top 1% rank</strong> among 33,131 students in NPTEL IoT certification, IIT Kharagpur.</div>
                  <div class="highlight"><strong>CS50's AI with Python</strong> certificate, Harvard University / edX.</div>
                  <div class="highlight"><strong>CS50x</strong> Introduction to Computer Science certificate, Harvard University.</div>
                  <div class="highlight"><strong>3 merged PRs</strong> in ListenBrainz, used by 1M+ users.</div>
              </div>
          </div>
          <article class="entry">
              <div class="logo" aria-hidden="true">GGV</div>
              <div class="entry-body">
                  <h3>Guru Ghasidas Vishwavidyalaya</h3>
                  <p class="role">B.Tech in Electronics &amp; Communication</p>
                  <p class="date">Graduating May 2026 · CGPA 8.10 / 10.0</p>
              </div>
          </article>
      </section>

      <section id="activity">
          <h2 class="heading">GitHub Activity</h2>
          <GithubActivity />
      </section>

      <section id="writing">
          <h2 class="heading">Writing</h2>
          <BlogList posts={latest} />
          <a class="more" href="/blogs/">All articles →</a>
      </section>

      <footer>
          <p class="quote quote-ar" lang="ar" dir="rtl">توكّل</p>
          <p class="quote-en">Tawakkul</p>
          <small>&copy; 2026 Mohammad Shahnawaz</small>
      </footer>
  </main>
</Base>
